{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"title": "Item Card 1 Align Start",
	"slug": "ext-preset--group--natural-1--item-card-1--align-start",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"css": "& :where(.ext-card-body:not(.is-layout-flex) .wp-block-group) { margin-top: var(--wp--preset--spacing--30); } & :where(.ext-card-body.is-layout-flex > .wp-block-group) { margin-top: 0; }",
		"blocks": {
			"core/heading": {
				"typography": {
					"fontSize": "1.5rem"
				},
				"spacing": {
					"margin": {
						"top": "16px"
					}
				}
			},
			"core/paragraph": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				},
				"spacing": {
					"margin": {
						"top": "16px"
					}
				}
			}
		}
	}
}
