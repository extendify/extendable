{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"title": "Link",
	"slug": "ext-link",
	"blockTypes": [
		"core/button",
		"woocommerce/product-button"
	],
	"styles": {
		"color": {
			"text": "var(--wp--custom--color--text-brand)",
			"background": "transparent"
		},
		"typography": {
			"textDecoration": "underline"
		},
		"border": {
			"width": "0"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "0",
				"right": "0"
			}
		},
		"shadow": "none",
		":hover": {
			"color": {
				"text": "var(--wp--custom--color--text-brand)",
				"background": "transparent"
			},
			"typography": {
				"textDecoration": "underline dashed"
			}
		},
		":active": {
			"color": {
				"text": "var(--wp--custom--color--text-brand)",
				"background": "transparent"
			},
			"typography": {
				"textDecoration": "none"
			}
		}
	}
}
