{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"title": "Display",
	"slug": "ext-text-display",
	"blockTypes": [
		"core/paragraph"
	],
	"styles": {
		"typography": {
			"fontSize": "var(--wp--custom--text--display--font-size)",
			"fontWeight": "var(--wp--custom--text--display--font-weight)",
			"lineHeight": "var(--wp--custom--text--display--line-height)",
			"letterSpacing": "var(--wp--custom--text--display--letter-spacing)",
			"textTransform": "var(--wp--custom--text--display--text-transform)"
		}
	}
}
