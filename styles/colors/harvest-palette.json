				{
					"slug": "primary",
					"color": "#3B2A20",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#513E34",
					"name": "Secondary"
				},
				{
					"slug": "tertiary",
					"color": "var(--wp--custom--color--background-sunken)",
					"name": "Tertiary"
				},
				{
					"slug": "foreground-alt",
					"color": "var(--wp--custom--color--text-weak)",
					"name": "Foreground Alt"
				}
			]
		},
		"custom": {
			"color": {
				"text-strong": "#3B2A20",
				"background-base": "#F2EFE3",
				"text-weak": "#675449",
