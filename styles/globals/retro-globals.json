{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Retro Globals",
	"slug": "ext-retro-globals",
	"styles": {
		"elements": {
			"h1": {
				"typography": {
					"fontSize": "clamp(2.405rem, 2.405rem + ((1vw - 0.2rem) * 4.117), 4.875rem)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(1.95rem, 1.95rem + ((1vw - 0.2rem) * 3.25), 3.9rem)"
				}
			}
		}
	}
}
