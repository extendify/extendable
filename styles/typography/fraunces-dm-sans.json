{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"title": "Fraunces + DM Sans",
	"version": 3,
	"slug": "fraunces-dm-sans",
	"styles": {
		"typography": {
			"fontFamily": "\"DM Sans\", sans-serif",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "\"Fraunces\", serif",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				}
			}
		},
		"blocks": {
			"core/quote": {
				"typography": {
					"fontFamily": "\"Fraunces\", serif",
					"fontStyle": "italic"
				}
			}
		}
	}
}
