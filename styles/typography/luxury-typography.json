{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Luxury",
	"slug": "ext-luxury",
	"styles": {
		"typography": {
			"fontFamily": "'Source Serif Pro', 'Source Serif 4', Georgia, 'Times New Roman', serif",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "'Source Serif Pro', 'Source Serif 4', Georgia, 'Times New Roman', serif",
					"fontWeight": "400"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "400",
					"letterSpacing": "0.01em"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "400",
					"letterSpacing": "0.01em"
				}
			}
		}
	}
}
