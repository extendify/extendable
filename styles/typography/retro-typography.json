{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Retro · Fraunces / Heebo",
	"slug": "ext-retro",
	"styles": {
		"typography": {
			"fontFamily": "'Heebo', system-ui, -apple-system, 'Segoe UI', sans-serif"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "'Fraunces', 'Fraunces Variable', Georgia, 'Times New Roman', serif",
					"fontWeight": "800",
					"textTransform": "uppercase"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "900",
					"letterSpacing": "0.01em",
					"lineHeight": "1.05",
					"textTransform": "uppercase"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "900",
					"letterSpacing": "0.01em",
					"lineHeight": "1.05",
					"textTransform": "uppercase"
				}
			}
		}
	}
}
