{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Storybook",
	"slug": "ext-storybook",
	"styles": {
		"typography": {
			"fontFamily": "'Manrope', 'Manrope Variable', system-ui, -apple-system, sans-serif",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "'Baloo Tamma 2', 'Baloo Tamma2', system-ui, -apple-system, sans-serif",
					"fontWeight": "600"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "700",
					"letterSpacing": "0em",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "700",
					"letterSpacing": "0em",
					"lineHeight": "1.15"
				}
			}
		}
	}
}
