				{
					"slug": "70",
					"name": "Huge",
					"size": "calc(clamp(4rem, 15vw, 7rem) * var(--wp--custom--space-scale, 1))"
				}
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
